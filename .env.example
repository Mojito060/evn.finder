# Copy this file to .env on the server (next to docker-compose.prod.yml)
# and fill in real values. Never commit the real .env file.

NODE_ENV=production
PORT=9042
PRETTY_LOG=false
USER_AGENT=evn-finder

# RIS (DB Reisendeninformationssystem) API credentials
RIS_JOURNEYS_URL=
RIS_JOURNEYS_CLIENT_ID=
RIS_JOURNEYS_CLIENT_SECRET=
RIS_JOURNEYS_USER_AGENT=
RIS_JOURNEYS_CACHE_TTL=

RIS_JOURNEYS_V2_URL=
RIS_JOURNEYS_V2_CLIENT_ID=
RIS_JOURNEYS_V2_CLIENT_SECRET=

RIS_STATIONS_URL=
RIS_STATIONS_CLIENT_ID=
RIS_STATIONS_CLIENT_SECRET=

RIS_BOARDS_URL=
RIS_BOARDS_CLIENT_ID=
RIS_BOARDS_CLIENT_SECRET=

# Wagon sequence (coach sequence) API - ohne diese Werte greift der
# unauthentifizierte bahn.de-Fallback (siehe README, "EVN suchen" braucht
# aber zwingend echte RIS::Transports-Zugangsdaten)
COACH_SEQUENCE_URL=
COACH_SEQUENCE_CLIENT_ID=
COACH_SEQUENCE_CLIENT_SECRET=
COACH_SEQUENCE_CACHE_TTL=

# Nicht Teil der reduzierten EVN-Finder-Feature-Menge, hier nur der
# Vollständigkeit halber falls der Code-Pfad noch irgendwo referenziert
# wird - können unbefüllt bleiben:
RIS_MAPS_URL=
RIS_MAPS_CLIENT_ID=
RIS_MAPS_CLIENT_SECRET=
RIS_CONNECTIONS_URL=
RIS_CONNECTIONS_CLIENT_ID=
RIS_CONNECTIONS_CLIENT_SECRET=
IRIS_URL=
IRIS_FALLBACK_URL=
PRIVATE_API_URL=
PRIVATE_API_KEY=
